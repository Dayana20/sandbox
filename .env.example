APP_NAME=Document Storage Service

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Optional fallback: a short-lived token from the App Console (expires after ~4 hours)
DROPBOX_ACCESS_TOKEN=

# Upload idempotency. Only uploads that send an Idempotency-Key use Redis.
# Without REDIS_URL those uploads are refused (503). Uploads without a key still work.
REDIS_URL=redis://localhost:6379/0
# How long an Idempotency-Key is remembered (seconds). 86400 = 24 hours.
IDEMPOTENCY_TTL_SECONDS=86400
