APP_NAME=Document Storage Service

# Calendar provider: "fake" for local development/tests or "team5".
CALENDAR_IMPL=fake
# Required only when CALENDAR_IMPL=team5. Keep the token file outside git.
TEAM5_TOKEN_FILE=

# Issue tracker provider: "fake" for local development/tests or "team4".
TRACKER_IMPL=fake
# Required only when TRACKER_IMPL=team4. Use a dedicated Trello test account.
# Get the API key from https://trello.com/apps/admin, then authorize a
# read/write token for that key. Set TRELLO_LIST_ID to the full ID of the
# test list where issues should be created.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=

DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Optional fallback: a short-lived token from the App Console (expires after ~4 hours)
DROPBOX_ACCESS_TOKEN=

# Redis, shared by the metadata cache and upload idempotency (optional).
# Empty means no cache, and uploads that send an Idempotency-Key are refused
# (503). Uploads without a key still work. To turn it on, start Redis and set
# REDIS_URL=redis://localhost:6379/0 (see README > Setup > Redis).
REDIS_URL=
# How long cached metadata may be stale (seconds). 0 turns the cache off.
METADATA_CACHE_TTL_SECONDS=60
# How long an Idempotency-Key is remembered (seconds). 86400 = 24 hours.
IDEMPOTENCY_TTL_SECONDS=86400
